# Copy this file to .env.local and fill in real values.

# --- Supabase (create a project at supabase.com, then Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com) — powers the actual CV scoring ---
ANTHROPIC_API_KEY=

# --- Optional: Upstash Redis, for real rate limiting on the public /apply
# endpoint. If left unset, an in-memory rate limiter is used instead (fine
# for one server instance, resets if the server restarts). ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Demo mode: set to "true" to run the whole app against in-memory seed
# data with no Supabase project at all — useful for a first look or a
# screenshot. Leave unset/"false" for real use. ---
NEXT_PUBLIC_DEMO_MODE=false
